# Anthropic Claude API — get from console.anthropic.com
ANTHROPIC_API_KEY=your_key_here
# ThreatScan backend URL — your already-built enrichment engine
THREATSCAN_API_URL=https://threatscan-production.up.railway.app/api
# Environment
ENV=production
# Frontend URL — for CORS lock (your Vercel URL once deployed)
FRONTEND_URL=https://your-soctriage-frontend.vercel.app
# Database — optional locally (defaults to a local SQLite file);
# Railway provides this automatically when a PostgreSQL service is attached
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Abuse controls (backend/limits.py) ───────────────────────────────────────
# All optional: each falls back to a conservative default when unset, and a
# junk or non-positive value falls back too, so a typo cannot disable a cap.
# State is in-memory and single-instance; it resets when the process restarts.
#
# Per-IP rate limit, shared across all four write endpoints (429 + Retry-After).
# The default averages 2 req/min, under VirusTotal's 4/min ceiling upstream.
SOCTRIAGE_IP_RATE=10
SOCTRIAGE_IP_WINDOW_SECONDS=300
# Global ceiling on POST /api/triage per UTC day (503). The only endpoint that
# spends Anthropic and ThreatScan quota, so the only one with a global cap.
SOCTRIAGE_DAILY_TRIAGE_CAP=50
# Free-text length caps (400).
SOCTRIAGE_MAX_RAW_ALERT_CHARS=10000
SOCTRIAGE_MAX_IOC_CHARS=256
SOCTRIAGE_MAX_NOTE_CHARS=2000

# ── API key authentication (backend/auth.py) ─────────────────────────────────
# The OPERATOR key. A valid key sees and changes every case, including the
# ones opened before case ownership existed. Visitors need no key: each browser
# sends its own random X-Session-Token and reaches only the cases it opened.
# FAILS CLOSED: with this unset, no request is ever the operator, so nobody can
# reach another visitor's cases or the ownerless legacy ones.
#
# Clients send the key in the "X-API-Key" request header. It never goes in the
# frontend build; an operator types it into the page at runtime.
#
# Comma-separate several values to rotate without downtime: add the new key,
# move clients across, then drop the old one. Whitespace around each value is
# trimmed and blank entries are ignored, so a stray comma cannot become a key.
#
# Generate one that is worth having (the gate is constant-time, but nothing
# saves a guessable key):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SOCTRIAGE_API_KEYS=replace_me_with_a_generated_key
